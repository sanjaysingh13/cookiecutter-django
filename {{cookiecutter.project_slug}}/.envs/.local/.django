# General
# ------------------------------------------------------------------------------
USE_DOCKER=yes
IPYTHONDIR=/app/.ipython

{%- if cookiecutter.use_celery == 'y' %}
# Redis
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# Celery
# ------------------------------------------------------------------------------

# Flower
CELERY_FLOWER_USER=!!!SET CELERY_FLOWER_USER!!!
CELERY_FLOWER_PASSWORD=!!!SET CELERY_FLOWER_PASSWORD!!!
{%- endif %}
{%- if cookiecutter.use_neo4j == 'y' %}

# Neo4j
# ------------------------------------------------------------------------------
# Django reaches the neo4j service with NEO4J_AUTH from .envs/.local/.neo4j.
# For a different server, set NEOMODEL_DATABASE_URL=bolt://neo4j:<password>@<host>:7687
{%- endif %}
